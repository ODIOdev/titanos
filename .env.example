# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Enable Google + Apple under Authentication → Providers in the Supabase dashboard.
# Set the callback URL to: {NEXT_PUBLIC_SITE_URL}/auth/callback

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Places (admin ship-to autocomplete — Places API New)
# Enable Places API (New) in Google Cloud; restrict key to Places Autocomplete + Details.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=

# ShipEngine / ShipStation API (admin labels)
# Preferred: store the key in Supabase secrets and deploy the edge function:
#   supabase secrets set SHIPENGINE_API_KEY=xxx
#   supabase functions deploy shipengine
# Optional Vercel/.env.local fallback (same key) if the edge function isn’t deployed yet:
# SHIPENGINE_API_KEY=
# Optional ship-from overrides (defaults to SITE_CONFIG / Admin → Settings → Shipping portal)
# SHIPENGINE_SHIP_FROM_NAME=Titan Safety Co.
# SHIPENGINE_SHIP_FROM_COMPANY=Titan Safety Co.
# SHIPENGINE_SHIP_FROM_PHONE=1-800-848-2673
# SHIPENGINE_SHIP_FROM_LINE1=2400 Industrial Parkway
# SHIPENGINE_SHIP_FROM_LINE2=
# SHIPENGINE_SHIP_FROM_CITY=Houston
# SHIPENGINE_SHIP_FROM_STATE=TX
# SHIPENGINE_SHIP_FROM_POSTAL=77001
# SHIPENGINE_SHIP_FROM_COUNTRY=US
# Optional pinned carrier account IDs (from ShipEngine dashboard → API → Carriers)
# SHIPENGINE_CARRIER_IDS=se-6567510,se-6567511,se-6567512,se-6567513

# Vercel (optional locally — enables API stack health checks)
# Create a token at https://vercel.com/account/tokens or reuse `vercel login` auth.
# VERCEL_TOKEN=
# VERCEL_PROJECT_PRODUCTION_URL=https://your-project.vercel.app
